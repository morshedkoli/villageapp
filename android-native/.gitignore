# Gradle
.gradle/
build/
local.properties

# IDE
.idea/
*.iml

# Firebase configuration (per-developer, supplied from the Firebase console)
app/google-services.json

# Signing keys — never commit a release key.
# app/debug.keystore is the standard CN=Android Debug key (password "android");
# it is committed so every clone builds with the same SHA1 already registered
# for Google Sign-In in the Firebase console.
*.keystore
*.jks
!app/debug.keystore
