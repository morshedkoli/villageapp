rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function requestEmail() {
      return ("email" in request.auth.token && request.auth.token.email != null)
        ? request.auth.token.email.lower()
        : "";
    }

    // Kept in sync by hand with DEFAULT_BOOTSTRAP_ADMIN_EMAILS in
    // src/lib/admin-access.ts — rules cannot read environment variables, and
    // they deploy separately from the app. Change both together.
    function isBootstrapAdmin() {
      return request.auth != null && requestEmail() == "murshedkoli@gmail.com";
    }

    function isAdmin() {
      return request.auth != null &&
        ( ("admin" in request.auth.token && request.auth.token.admin == true)
         || isBootstrapAdmin()
         || (requestEmail() != "" && exists(/databases/$(database)/documents/admins/$(requestEmail())))
        );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A vote toggle/switch changes upvotes and/or downvotes by exactly 1
    // in either direction — never an arbitrary jump.
    function isValidVoteDelta(field) {
      return !(field in request.resource.data.diff(resource.data).affectedKeys()) ||
        (request.resource.data[field] - resource.data[field] == 1) ||
        (request.resource.data[field] - resource.data[field] == -1);
    }

    match /villages/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if request.auth != null &&
        (isAdmin() || adminId == requestEmail());
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      // Owners may edit their own profile, but not admin-controlled
      // moderation fields like `blocked` or `addedBy`.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blocked', 'addedBy'])
      );
      allow delete: if isAdmin();
    }

    match /users/{userId}/notification_reads/{notificationId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(['readAt']) &&
        request.resource.data.readAt is timestamp;
      allow delete: if isOwner(userId);
    }

    // Legacy citizen profiles used by older admin panels.
    match /citizens/{citizenId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.keys().hasAll(['transactionId', 'senderNumber', 'paymentMethod']);
      allow update, delete: if isAdmin();
    }

    match /fund_transactions/{transactionId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /problems/{problemId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'downvotes']) &&
        isValidVoteDelta('upvotes') &&
        isValidVoteDelta('downvotes')
      );
      allow delete: if isAdmin();

      // Votes subcollection
      match /votes/{voterId} {
        allow read: if true;
        allow create, update, delete: if isSignedIn() && voterId == request.auth.uid;
      }
    }

    // Application configuration (e.g., payment methods)
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
